rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() { 
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower() == 'admin@inflex.com' ||
        request.auth.token.email.lower() == 'seneiaislam@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role']) 
        && data.keys().hasOnly(['name', 'email', 'role', 'wishlist', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.role in ['user', 'admin']
        && (data.get('wishlist', []) is list);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'description', 'category', 'price']) 
        && data.keys().hasOnly(['name', 'description', 'category', 'price', 'stock', 'images', 'specifications', 'isFeatured', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() <= 200
        && data.price is number;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['totalAmount', 'paymentMethod']) 
        && data.keys().hasOnly(['userId', 'items', 'totalAmount', 'shippingAddress', 'paymentMethod', 'paymentStatus', 'orderStatus', 'customerName', 'phoneNumber', 'courierName', 'trackingId', 'deliveryStatus', 'orderDate', 'deliveryDate', 'createdAt', 'updatedAt'])
        && data.totalAmount is number;
    }

    function isValidPartner(data) {
      return data.keys().hasAll(['name', 'email', 'investmentAmount', 'profitSharePercentage'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'investmentAmount', 'profitSharePercentage', 'joinDate', 'status', 'createdAt', 'updatedAt']);
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['invoiceNumber', 'customerName', 'totalAmount'])
        && data.keys().hasOnly(['invoiceNumber', 'customerName', 'customerEmail', 'customerAddress', 'items', 'subtotal', 'taxAmount', 'discountAmount', 'totalAmount', 'issueDate', 'dueDate', 'status', 'createdAt', 'updatedAt']);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && (isAdmin() || (request.auth.uid == userId && isValidUser(incoming())));
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (isAdmin() || incoming().userId == request.auth.uid) && isValidOrder(incoming());
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'updatedAt']));
    }

    match /partners/{partnerId} {
      allow read, write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    match /importRequests/{requestId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn();
    }
    
    match /courierTrackingCache/{trackingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
